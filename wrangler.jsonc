{
  // Kairos — configuration Cloudflare Workers (fichiers statiques + API + D1)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kairos",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      // Pas d'ID figé : au déploiement, Wrangler se connecte à « kairos-db »
      // si elle existe, ou la crée automatiquement. Le Worker crée ses tables.
      "database_name": "kairos-db",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
